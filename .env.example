# Конфигурация базы данных
DATABASE_NAME=mydatabase   # Имя базы данных
DATABASE_USER=username     # Имя пользователя базы данных
DATABASE_PASSWORD=password # Пароль базы данных
DATABASE_HOST=localhost    # Хост для базы данных
DATABASE_PORT=5432         # Порт

# Бэкенд отправки писем
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # console.EmailBackend - для разработки

# SMTP сервер
EMAIL_HOST=smtp.yandex.ru  # smtp.gmail.com - для Gmail, smtp.yandex.ru - для Яндекс, smtp.mail.ru - для Mail.ru

# Порт SMTP
EMAIL_PORT=587  # 587 - для TLS, 465 - для SSL

# Использовать TLS
EMAIL_USE_TLS=True  # True для порта 587

# Использовать SSL
EMAIL_USE_SSL=False  # True для порта 465

# Email отправителя
EMAIL_HOST_USER=your-email@example.com  # Ваш email адрес

# Пароль от email (для Gmail и Яндекс используйте пароль приложения)
EMAIL_HOST_PASSWORD=your-app-password  # Пароль или пароль приложения

# Email отправителя по умолчанию
DEFAULT_FROM_EMAIL=your-email@example.com  # Обычно совпадает с EMAIL_HOST_USER